{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hello-voice1",
  "version": "0.1.0",
  "identifier": "local.hello.voice1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hello-voice1",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"]
  }
}
